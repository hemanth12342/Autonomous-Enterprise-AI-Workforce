# =============================================================
# AUTONOMOUS ENTERPRISE AI WORKFORCE — Environment Configuration
# =============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# =============================================================

# ─────────────────────────────────────────────────
# APPLICATION
# ─────────────────────────────────────────────────
APP_NAME="Autonomous Enterprise AI Workforce"
APP_ENV=development                       # development | staging | production
APP_SECRET_KEY=change_me_to_a_long_random_secret
DEBUG=true
LOG_LEVEL=INFO
DEMO_MODE=true                            # true = simulate external APIs safely

# ─────────────────────────────────────────────────
# JWT / AUTH
# ─────────────────────────────────────────────────
JWT_SECRET=change_me_to_another_long_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─────────────────────────────────────────────────
# DATABASE (PostgreSQL + pgvector)
# ─────────────────────────────────────────────────
POSTGRES_DB=ai_workforce
POSTGRES_USER=ai_workforce
POSTGRES_PASSWORD=change_me_strong_password
DATABASE_URL=postgresql+asyncpg://ai_workforce:change_me_strong_password@localhost:5432/ai_workforce

# ─────────────────────────────────────────────────
# REDIS
# ─────────────────────────────────────────────────
REDIS_PASSWORD=change_me_redis_password
REDIS_URL=redis://:change_me_redis_password@localhost:6379/0

# ─────────────────────────────────────────────────
# NEO4J (Knowledge Graph)
# ─────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_neo4j_password

# ─────────────────────────────────────────────────
# LLM PROVIDERS
# ─────────────────────────────────────────────────
# Primary provider: openai | groq | azure | bedrock
LLM_PROVIDER=groq

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_FAST_MODEL=gpt-4o-mini

# Groq (fast, cost-effective)
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_key
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-01

# AWS Bedrock
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_REGION=us-east-1
AWS_BEDROCK_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0

# ─────────────────────────────────────────────────
# EMBEDDING MODEL
# ─────────────────────────────────────────────────
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ─────────────────────────────────────────────────
# GITHUB INTEGRATION
# ─────────────────────────────────────────────────
GITHUB_TOKEN=ghp_...
GITHUB_ORG=your_organization
GITHUB_DEFAULT_REPO=ai-workforce-projects

# ─────────────────────────────────────────────────
# SLACK INTEGRATION
# ─────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_NOTIFICATION_CHANNEL=#ai-workforce

# ─────────────────────────────────────────────────
# EMAIL INTEGRATION
# ─────────────────────────────────────────────────
EMAIL_PROVIDER=smtp                       # smtp | sendgrid | ses
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@company.com
SMTP_PASSWORD=your_app_password
SENDGRID_API_KEY=SG...

# ─────────────────────────────────────────────────
# FRONTEND
# ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_APP_NAME="AI Workforce OS"

# ─────────────────────────────────────────────────
# MONITORING
# ─────────────────────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PASSWORD=admin

# ─────────────────────────────────────────────────
# AGENT LIMITS
# ─────────────────────────────────────────────────
MAX_CONCURRENT_AGENTS=10
MAX_AGENT_RETRIES=3
MAX_TASK_RETRIES=5
MAX_WORKFLOW_RETRIES=2
MAX_TOOL_CALLS_PER_TASK=50
MAX_LLM_CALLS_PER_TASK=30

# ─────────────────────────────────────────────────
# COST LIMITS (USD)
# ─────────────────────────────────────────────────
DEFAULT_PROJECT_BUDGET=10.00
DEFAULT_AGENT_BUDGET=3.00
DEFAULT_TASK_BUDGET=1.00
COST_ALERT_THRESHOLD=0.80               # 80% of budget triggers alert

# ─────────────────────────────────────────────────
# SECURITY
# ─────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60                    # seconds
ENABLE_AUDIT_LOG=true
